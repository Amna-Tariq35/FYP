NEXT_PUBLIC_DEEPAR_LICENSE_KEY=
NEXT_PUBLIC_SITE_URL=

# Comma-separated Gemini model ids, names only, first tried first. Unset uses these defaults.
GEMINI_ROUTINE_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_CHAT_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_VISION_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# When set, prepended to GEMINI_VISION_MODELS (or the defaults) and tried first.
GEMINI_VISION_MODEL=

